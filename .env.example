# Public base URL used for canonical URLs, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://www.anovatesystems.com

# --- Inquiry delivery (configure ONE of the options below) ---
# Option A: Resend (https://resend.com) transactional email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option B: forward inquiries as JSON to a webhook (CRM, Zapier, Make, Slack workflow, etc.)
CONTACT_WEBHOOK_URL=

# --- Inventory product ---
# When set, "Start subscription" buttons link to the live product signup instead of the access-request form
NEXT_PUBLIC_INVENTORY_SIGNUP_URL=

# --- Analytics (optional) ---
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Loaded only when set.
NEXT_PUBLIC_GTM_ID=
